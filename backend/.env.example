# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/careerviewx

# JWT Secret Key (Change this to a random secure string in production)
JWT_SECRET=careerviewx_super_secret

# Server Port
PORT=5000

# Email Service Configuration (Gmail SMTP)
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Frontend URL used in email links (verification/reset-password)
FRONTEND_URL=https://careerviewx.vercel.app
